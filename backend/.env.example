# ── Server ──────────────────────────────────────────
PORT=5000

# ── Database ────────────────────────────────────────
# Get a free MongoDB Atlas cluster at https://cloud.mongodb.com
# Create a cluster → Connect → Drivers → copy the connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Authentication ───────────────────────────────────
# Any long random string (min 32 characters)
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_minimum_32_characters

# ── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ── Email OTP ────────────────────────────────────────
# Gmail account used to send OTP verification emails
EMAIL_USER=your_gmail@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get it:
#   1. Go to https://myaccount.google.com
#   2. Security → 2-Step Verification → Enable
#   3. Security → App passwords → Create → name it "WhatsApp Clone"
#   4. Copy the 16-character code and paste here (no spaces)
EMAIL_PASS=abcdefghijklmnop
